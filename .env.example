# ==============================================
# DZ-CarPool - Environment Configuration (.env.example)
# ==============================================

# Backend Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="DZ-CarPool API"
APP_VERSION="1.0.0"

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=change-this-to-a-super-secret-key-in-production-dz-carpool-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite fallback for instant zero-dependency execution:
DATABASE_URL=sqlite:///./dz_carpool.db
# PostgreSQL for production / Docker:
# DATABASE_URL=postgresql://dzcarpool_user:dzcarpool_pass@postgres:5432/dzcarpool_db

# External / Mock Fuel Data Path
FUEL_PRICES_FILE_PATH=./data/prix_carburants.json

# Business Rules Constants
PLATFORM_COMMISSION_RATE=0.15
COMFORT_SURCHARGE_RATE=0.30
REST_STOP_THRESHOLD_KM=300
MANDATORY_REST_DURATION_MINUTES=15
AVG_FUEL_CONSUMPTION_L_PER_100KM=8.0

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEFAULT_LANGUAGE=fr
